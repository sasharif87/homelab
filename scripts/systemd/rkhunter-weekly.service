[Unit]
Description=Weekly rootkit and system integrity scan via rkhunter

[Service]
Type=oneshot
ExecStart=/opt/scripts/rkhunter-weekly.sh
EnvironmentFile=/etc/container-watchdog.env
Nice=19
IOSchedulingClass=idle
MemoryMax=256M
CPUQuota=25%
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rkhunter-weekly
