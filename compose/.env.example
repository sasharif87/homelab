# ─── Network ──────────────────────────────────────────────────────────────────
# IP of your services VM (where Docker runs)
SERVER_IP=192.168.1.x
# IP of your Proxmox host
PROXMOX_IP=192.168.1.y
# Your public domain (e.g. yourname.duckdns.org)
DOMAIN=yourname.duckdns.org
# Your LAN subnet in CIDR notation — used by Gluetun firewall rules
LAN_SUBNET=192.168.1.0/24

# ─── VPN (Gluetun / ProtonVPN WireGuard) ──────────────────────────────────────
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
# qBittorrent WebUI password — used by gluetun port-forward script
QBIT_PASS=

# ─── Media / Automation ───────────────────────────────────────────────────────
TA_PASSWORD=               # TubeArchivist admin password
TA_ES_PASSWORD=            # TubeArchivist Elasticsearch password

# ─── Personal ─────────────────────────────────────────────────────────────────
IMMICH_DB_PASSWORD=

# ─── File Share ───────────────────────────────────────────────────────────────
SAMBA_USER=youruser
SAMBA_PASSWORD=

# ─── Dashboard ────────────────────────────────────────────────────────────────
HOMARR_SECRET_KEY=         # 64-char hex string — generate: openssl rand -hex 32

# ─── Backup ───────────────────────────────────────────────────────────────────
DUPLICATI_ENCRYPTION_KEY=

# ─── Speedtest Tracker ──────────────────────────────────────────────────────────
SPEEDTEST_APP_KEY=         # 32-char base64 string — generate: docker run --rm lscr.io/linuxserver/speedtest-tracker:latest artisan key:generate --show

# ─── Notifications ────────────────────────────────────────────────────────────
NTFY_USER=
NTFY_PASS=
# Shoutrrr URL for Watchtower → ntfy (format: ntfy://user:pass@your-domain/topic)
WATCHTOWER_NTFY_URL=
# Discord webhook URL for Watchtower container update notifications
WATCHTOWER_DISCORD_URL=

# ─── IME (optional — only if running the IME project) ─────────────────────────
POSTGRES_PASSWORD=
OLLAMA_MODEL=qwen2.5:14b
GDRIVE_FOLDER_ID=
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_OAUTH_REDIRECT_URI=https://ime.${DOMAIN}/api/auth/drives/oauth/callback
ANTHROPIC_API_KEY=
IME_DATA_ROOT=/mnt/apps/appdata/ime/data
